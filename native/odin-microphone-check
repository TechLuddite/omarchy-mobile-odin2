#!/usr/bin/env python3
"""Touch-controlled capture check. The ordinary launcher waits for Start.

Explicit diagnostic flags support one bounded visible recording of an
authorized controlled audio source, and a direct ALSA comparison.

Uses PipeWire and Peter Jackson's Voxtype. Test recordings stay in the
device user's private state directory, outside the project source.
"""
import argparse
import array
import datetime
import math
import os
from pathlib import Path
import signal
import subprocess
import threading
import time
import wave

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import GLib, Gtk

RATE = 16000
LIMIT = 20


class MicrophoneCheck(Gtk.Application):
    def __init__(self, fixture=None, record_once=False, alsa_device=None):
        super().__init__(application_id="org.techluddite.OdinMicrophoneCheck")
        self.fixture = fixture
        self.record_once = record_once
        self.alsa_device = alsa_device
        self.rate = 48000 if alsa_device else RATE
        self.channels = 2 if alsa_device else 1
        self.recorder = None
        self.transcriber = None
        self.busy = False
        self.closing = False
        self.started = 0
        self.connect("activate", self.activate)

    def activate(self, _app):
        if self.get_active_window():
            self.get_active_window().present()
            return
        window = Gtk.ApplicationWindow(application=self, title="Odin Microphone Check")
        window.set_default_size(700, 480)
        window.connect("close-request", self.close)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for side in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{side}")(22)
        window.set_child(box)
        title = Gtk.Label(label="Check microphone and dictation", xalign=0)
        title.add_css_class("title-1")
        box.append(title)
        instruction = Gtk.Label(
            label="Tap Start, then speak while Recording is shown.\n"
                  "The test stops after 20 seconds; you can stop it sooner.",
            xalign=0, wrap=True)
        box.append(instruction)
        self.status = Gtk.Label(label="Ready — microphone is off", xalign=0, wrap=True)
        self.status.add_css_class("title-2")
        box.append(self.status)
        self.meter = Gtk.ProgressBar(show_text=True, text="Input level")
        self.meter.set_size_request(-1, 28)
        box.append(self.meter)
        self.level = Gtk.Label(label="", xalign=0)
        box.append(self.level)
        controls = Gtk.Box(spacing=16, homogeneous=True)
        self.start_button = Gtk.Button(label="Start recording")
        self.start_button.set_size_request(-1, 58)
        self.start_button.add_css_class("suggested-action")
        self.start_button.connect("clicked", self.start)
        self.stop_button = Gtk.Button(label="Stop and transcribe", sensitive=False)
        self.stop_button.set_size_request(-1, 58)
        self.stop_button.connect("clicked", self.stop)
        controls.append(self.start_button)
        controls.append(self.stop_button)
        box.append(controls)
        self.result = Gtk.TextView(editable=False, cursor_visible=False,
                                   wrap_mode=Gtk.WrapMode.WORD_CHAR)
        self.result.set_top_margin(10)
        self.result.set_left_margin(10)
        scroll = Gtk.ScrolledWindow(vexpand=True, min_content_height=100)
        scroll.set_child(self.result)
        box.append(scroll)
        self.saved = Gtk.Label(label="No recording starts when this window opens.",
                               xalign=0, wrap=True, selectable=True)
        self.saved.add_css_class("dim-label")
        box.append(self.saved)
        window.present()
        if self.fixture:
            self.busy = True
            self.start_button.set_sensitive(False)
            self.status.set_label("Transcribing test file — microphone is off")
            threading.Thread(target=self.transcribe, args=(Path(self.fixture),),
                             daemon=True).start()
        elif self.record_once:
            # Explicit diagnostic mode for an authorized controlled audio source.
            # The normal launcher still waits for the user to tap Start.
            self.saved.set_label("One automatic 20-second test will start shortly.")
            GLib.timeout_add(1500, self.start_once)

    def start_once(self):
        if not self.closing:
            self.start(None)
        return False

    def start(self, _button):
        if self.busy:
            return
        directory = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
        directory = directory / "odin2-omarchy/microphone-tests"
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        directory.chmod(0o700)
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
        path = directory / f"microphone-{stamp}.wav"
        try:
            # Raw PCM makes the meter and saved WAV use the same input samples.
            command = (["arecord", "-D", self.alsa_device, "-t", "raw", "-r", str(self.rate),
                        "-c", str(self.channels), "-f", "S16_LE", "-"] if self.alsa_device else
                       ["pw-record", "--raw", "--rate", str(self.rate), "--channels", str(self.channels),
                        "--format", "s16", "-"])
            log_fd = os.open(path.with_suffix(".capture.log"),
                             os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(log_fd, "wb") as errors:
                self.recorder = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=errors)
        except OSError as error:
            self.status.set_label(f"Could not start recording: {error}")
            return
        self.busy = True
        self.started = time.monotonic()
        self.status.set_label("● Recording — speak now (0 / 20 seconds)")
        self.status.add_css_class("error")
        self.start_button.set_sensitive(False)
        self.stop_button.set_sensitive(True)
        self.result.get_buffer().set_text("")
        self.saved.set_label("Recording stays private on this Odin.")
        GLib.timeout_add(200, self.tick)
        threading.Thread(target=self.capture, args=(self.recorder, path), daemon=True).start()

    def tick(self):
        if not self.recorder or self.recorder.poll() is not None or self.closing:
            return False
        elapsed = time.monotonic() - self.started
        if elapsed >= LIMIT:
            self.stop(None)
            return False
        self.status.set_label(f"● Recording — speak now ({int(elapsed)} / 20 seconds)")
        return True

    def stop(self, _button):
        if self.recorder and self.recorder.poll() is None:
            self.recorder.send_signal(signal.SIGINT)
            self.stop_button.set_sensitive(False)

    def close(self, _window):
        self.closing = True
        self.stop(None)
        if self.transcriber and self.transcriber.poll() is None:
            self.transcriber.terminate()
        return False

    def capture(self, process, path):
        frames = 0
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "wb") as output, wave.open(output, "wb") as recording:
                recording.setnchannels(self.channels)
                recording.setsampwidth(2)
                recording.setframerate(self.rate)
                pending = b""
                while True:
                    chunk = process.stdout.read(1600)
                    if not chunk:
                        break
                    data = pending + chunk
                    even = len(data) - len(data) % (2 * self.channels)
                    pending = data[even:]
                    data = data[:even]
                    if not data:
                        continue
                    recording.writeframesraw(data)
                    samples = array.array("h", data)
                    peak = max(abs(value) for value in samples)
                    rms = math.sqrt(sum(value * value for value in samples) / len(samples))
                    frames += len(samples) // self.channels
                    GLib.idle_add(self.show_level, peak, rms, frames / self.rate)
            code = process.wait(timeout=5)
            GLib.idle_add(self.capture_done, frames / self.rate, code)
            if not self.closing and self.alsa_device:
                GLib.idle_add(self.complete, f"Direct ALSA test finished (exit {code}). Audio saved for analysis.", path)
            elif not self.closing and frames >= self.rate:
                self.transcribe(path)
            elif not self.closing:
                GLib.idle_add(self.complete, "No usable audio. Check the capture route.", path)
        except Exception as error:
            if process.poll() is None:
                process.kill()
            process.wait()
            if not self.closing:
                GLib.idle_add(self.complete, f"Capture failed: {error}", path)
        finally:
            process.stdout.close()

    def show_level(self, peak, rms, seconds):
        if self.closing:
            return False
        self.meter.set_fraction(min(1, peak / 32768))
        self.meter.set_text(f"Peak {100 * peak / 32768:.2f}%")
        self.level.set_label(f"Captured {seconds:.1f}s · peak {peak} · RMS {rms:.1f}")
        return False

    def capture_done(self, seconds, code):
        self.recorder = None
        self.stop_button.set_sensitive(False)
        self.status.remove_css_class("error")
        self.status.set_label("Microphone off — direct ALSA capture finished"
                              if self.alsa_device else
                              f"Microphone off — transcribing {seconds:.1f}s of audio"
                              if seconds >= 1 else f"Capture ended (exit {code})")
        return False

    def transcribe(self, path):
        try:
            # v1.1.0 prints file diagnostics first and a blank line before the
            # transcript. Quiet mode suppresses info logs; show only the words.
            environment = dict(os.environ, RUST_LOG="error", NO_COLOR="1")
            self.transcriber = subprocess.Popen(
                ["voxtype", "--quiet", "transcribe", str(path)],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                text=True, env=environment)
            output, errors = self.transcriber.communicate(timeout=120)
            if self.transcriber.returncode:
                message = f"Transcription failed (exit {self.transcriber.returncode}).\n{errors[-1500:]}"
            else:
                message = output.partition("\n\n")[2].strip() or "No words detected. Capture is not yet verified."
        except (OSError, subprocess.TimeoutExpired) as error:
            if self.transcriber and self.transcriber.poll() is None:
                self.transcriber.kill()
                self.transcriber.communicate()
            message = f"Transcription failed: {error}"
        if not self.closing:
            GLib.idle_add(self.complete, message, path)

    def complete(self, message, path):
        if self.closing:
            return False
        self.busy = False
        self.status.set_label("Test finished — microphone is off")
        self.start_button.set_sensitive(True)
        self.result.get_buffer().set_text(message)
        self.saved.set_label(f"Audio file: {path}")
        return False


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--transcribe", metavar="WAV", help="Test a saved file without recording")
    mode.add_argument("--record-once", action="store_true",
                      help="Run one visible 20-second recording of an authorized test source")
    parser.add_argument("--alsa-device", metavar="PCM",
                        help="Diagnostic capture directly from ALSA at 48 kHz stereo")
    args = parser.parse_args()
    if args.transcribe and args.alsa_device:
        parser.error("--alsa-device cannot be used with --transcribe")
    raise SystemExit(MicrophoneCheck(args.transcribe, args.record_once, args.alsa_device).run([]))
